generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Edge {
  id              Int           @id @default(autoincrement())
  score           Float?
  nodes           Node[]
  reason          String?
  knowledgeFileId Int
  knowledgeFile   KnowledgeFile @relation(fields: [knowledgeFileId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Node {
  id              Int           @id @default(autoincrement())
  title           String?
  authors         String[]
  source          String?
  contentSummary  String
  edges           Edge[]
  knowledgeFileId Int
  knowledgeFile   KnowledgeFile @relation(fields: [knowledgeFileId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  link            String
}

model KnowledgeFile {
  id          Int      @id @default(autoincrement())
  nodes       Node[]
  edges       Edge[]
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
