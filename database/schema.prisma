generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  name             String?
  password         String
  knowledgeFolders KnowledgeFolder[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model KnowledgeFolder {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  description String?
  color       String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  nodes       Node[]
  edges       Edge[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Node {
  id                Int             @id @default(autoincrement())
  title             String
  link              String
  authors           String[]        @default([])
  source            String?
  contentSummary    String?
  posX              Float?
  posY              Float?
  isOnGraph         Boolean         @default(false)
  knowledgeFolderId Int
  knowledgeFolder   KnowledgeFolder @relation(fields: [knowledgeFolderId], references: [id])
  firstNodeEdges    Edge[]          @relation("FirstNode")
  secondNodeEdges   Edge[]          @relation("SecondNode")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Edge {
  id                Int             @id @default(autoincrement())
  label             String?
  reasoning         String?
  score             Float?
  firstNodeId       Int
  firstNode         Node            @relation("FirstNode", fields: [firstNodeId], references: [id])
  secondNodeId      Int
  secondNode        Node            @relation("SecondNode", fields: [secondNodeId], references: [id])
  knowledgeFolderId Int
  knowledgeFolder   KnowledgeFolder @relation(fields: [knowledgeFolderId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}
