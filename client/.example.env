# Base URL of the Express API
#   docker-compose: http://localhost:5001/api
#   local dev:      http://localhost:<SERVER_PORT>/api
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Set to "true" to run the UI against in-memory sample data
# (useful while the server routes are still in progress)
NEXT_PUBLIC_USE_MOCK=true
